<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>ToastWindowProbe</AssemblyName>
    <RootNamespace>ToastWindowProbe</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 只编 Program.cs 与下面显式 Link 的真实源文件，不参与默认通配 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!--
      编入仓库里**真实的那份** ToastWindow.cs（不是副本）。
      用副本会随 src/ 的修改而漂移，探针就会开始验证一份不存在的代码。
      这个手法同时让 internal 的 ToastWindow 在探针程序集内可见，
      因此仓库不需要为探针加 InternalsVisibleTo。
    -->
    <Compile Include="..\..\src\QrScan\UI\ToastWindow.cs" Link="ToastWindow.cs" />
  </ItemGroup>

</Project>
