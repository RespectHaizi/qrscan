<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>QrScan</AssemblyName>
    <RootNamespace>QrScan</RootNamespace>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <!-- exe / taskbar / Alt+Tab icon (adaptive: simplified at 16/20, fuller at 24/32, original at 40+) -->
    <ApplicationIcon>Resources\qrscan.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QrScan.Core\QrScan.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Small-size subset for the tray, so the full ico is not embedded twice -->
    <EmbeddedResource Include="Resources\qrscan-tray.ico" LogicalName="QrScan.Resources.qrscan-tray.ico" />
  </ItemGroup>
</Project>
